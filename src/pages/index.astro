---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Héctor San Martín | Periodista & Especialista en Comunicación Digital">
    <!-- HEADER / NAVEGACIÓN -->
    <header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                <span class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></span>
                Héctor San Martín
            </a>
            
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="#reels" class="hover:text-emerald-400 transition-colors">Reels</a>
                <a href="#video-claude" class="hover:text-emerald-400 transition-colors">Video Claude</a>
                <a href="#mailing" class="hover:text-emerald-400 transition-colors">Mailing</a>
                <a href="#quien-soy" class="hover:text-emerald-400 transition-colors">¿Quién Soy?</a>
                <a href="#cv" class="hover:text-emerald-400 transition-colors">CV</a>
            </nav>

            <a href="https://wa.me/56949080786?text=%C2%A1Hola%20H%C3%A9ctor!%20Me%20interesa%20conversar%20contigo." target="_blank" class="hidden sm:inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-4 py-2 rounded-xl transition-all shadow-lg hover:scale-105">
                <span>Hablemos</span>
            </a>
        </div>
    </header>

    <main>
        <!-- HERO / PORTADA -->
        <section class="py-24 md:py-32 max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <span class="inline-block text-xs font-semibold tracking-wider uppercase text-emerald-400 bg-emerald-950/50 border border-emerald-800/50 px-3 py-1 rounded-full">
                    Disponible para proyectos y consultorías
                </span>
                <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white">
                    Transformo audiencias en <span class="text-emerald-400">comunidades activas</span> y fieles.
                </h1>
                <p class="text-slate-400 text-lg leading-relaxed">
                    Periodista y Licenciado en Comunicación Social. Más de 7 años de experiencia elevando el posicionamiento digital, el engagement, las campañas de email marketing y la gestión multimedia.
                </p>
                <div class="flex flex-wrap gap-4 pt-4">
                    <a href="#contacto" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-6 py-3 rounded-xl transition-all shadow-lg">
                        Iniciar Conversación
                    </a>
                    <a href="#mailing" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-xl transition-all border border-slate-700">
                        Ver Mailing
                    </a>
                </div>
            </div>

            <!-- Columna derecha: Foto de perfil y Tarjeta de impacto -->
            <div class="flex flex-col gap-6 items-center">
                <!-- Foto personal -->
                <div class="w-48 h-48 md:w-56 md:h-56 rounded-3xl overflow-hidden border-2 border-emerald-500/50 shadow-2xl bg-slate-900">
                    <img src="/perfil.jpg" alt="Héctor San Martín" class="w-full h-full object-cover">
                </div>

                <!-- Tarjeta de impacto (sin los 12k seguidores y con texto actualizado) -->
                <div class="w-full bg-slate-900/60 border border-slate-800 p-6 rounded-3xl backdrop-blur-sm shadow-2xl">
                    <h3 class="text-lg font-bold text-white mb-2">Impacto Comprobado</h3>
                    <p class="text-slate-400 text-sm mb-4">Crecimiento orgánico sostenido y optimización de impresiones de marca en entornos digitales.</p>
                    <div class="border-t border-slate-800 pt-4 space-y-3">
                        <div>
                            <div class="text-xl font-bold text-emerald-400">+7 Años de Experiencia</div>
                            <div class="text-xs text-slate-400 mt-1">Marketing Digital - Producción y Postproducción Audiovisual - Storytelling para RRSS</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: REELS -->
        <section id="reels" class="py-24 max-w-7xl mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                <h2 class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Contenido Digital</h2>
                <h3 class="text-3xl font-bold text-white">Reels</h3>
                <p class="text-slate-400">Engagement, storytelling y formato vertical optimizado para redes sociales.</p>
            </div>

            <div class="relative group">
                <button id="scroll-left-reels" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 sm:-translate-x-6 z-10 bg-slate-800/90 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg border border-slate-700 backdrop-blur-sm transition-all cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>

                <div id="carousel-track-reels" class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar pb-4 pt-2 px-1">
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DAtKIZtxbQx/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DPmssLsjW-F/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/Db6ShPqCJ9z/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/Dblv4OVAF84/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DP4qh7KDWF4/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                    <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DWCCfnDDnIp/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                    </div>
                </div>

                <button id="scroll-right-reels" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-6 z-10 bg-slate-800/90 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg border border-slate-700 backdrop-blur-sm transition-all cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </section>

        <!-- SECCIÓN: VIDEO CLAUDE -->
        <section id="video-claude" class="py-24 bg-slate-900/30 border-t border-slate-900 relative">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                    <h2 class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Innovación & IA</h2>
                    <h3 class="text-3xl font-bold text-white">Video hecho con tecnología Claude</h3>
                    <p class="text-slate-400">Desarrollo de contenido audiovisual asistido y programado mediante inteligencia artificial avanzada.</p>
                </div>

                <div class="relative group">
                    <button id="scroll-left-claude" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 sm:-translate-x-6 z-10 bg-slate-800/90 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg border border-slate-700 backdrop-blur-sm transition-all cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    </button>

                    <div id="carousel-track-claude" class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar pb-4 pt-2 px-1">
                        <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                            <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/Dfn7lXugHpW/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                        </div>
                        <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                            <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DffNO5oAoA_/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                        </div>
                        <div class="min-w-[320px] sm:min-w-[350px] flex-shrink-0 snap-start bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl flex flex-col items-center p-4">
                            <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DfV20ymAxds/" data-instgrm-version="14" style="background:#090d16; border:0; border-radius:16px; margin:0; max-width:540px; min-width:326px; padding:0; width:99.375%;"></blockquote>
                        </div>
                    </div>

                    <button id="scroll-right-claude" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-6 z-10 bg-slate-800/90 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg border border-slate-700 backdrop-blur-sm transition-all cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: MAILING & EMAIL MARKETING (con visores tipo Fancypdf / ejemplos campaign) -->
        <section id="mailing" class="py-24 max-w-7xl mx-auto px-6 border-t border-slate-900">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                <span class="text-xs font-semibold tracking-wider uppercase text-emerald-400 bg-emerald-950/50 border border-emerald-800/50 px-3 py-1 rounded-full">Estrategia Comercial</span>
                <h2 class="text-3xl sm:text-4xl font-bold text-white">Mailing & Email Marketing (Ejemplos Campaign)</h2>
                <p class="text-slate-400">Diseño, segmentación avanzada y automatización de campañas con visualización directa vía Fancypdf.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <!-- Campaign 1: Orbe Ambiental -->
                <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-bold text-white">Campaign: Orbe Ambiental</h3>
                            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full border border-emerald-500/30">PDF Viewer</span>
                        </div>
                        <p class="text-slate-400 text-sm mb-4">Ejemplo de campaña de cumplimiento ambiental y consultas de pertinencia.</p>
                    </div>
                    <div class="w-full h-[400px] bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden shadow-inner">
                        <iframe src="/campaign_orbe.pdf" class="w-full h-full" title="Campaign Orbe"></iframe>
                    </div>
                    <div class="mt-4 text-center">
                        <a href="/campaign_orbe.pdf" target="_blank" class="inline-block text-xs font-semibold text-emerald-400 hover:text-emerald-300 underline">Abrir campaign_orbe.pdf en pantalla completa</a>
                    </div>
                </div>

                <!-- Campaign 2: Seminario -->
                <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-xl font-bold text-white">Campaign: Seminario Proyectos</h3>
                            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full border border-emerald-500/30">PDF Viewer</span>
                        </div>
                        <p class="text-slate-400 text-sm mb-4">Ejemplo de campaña de invitación a seminarios de inversión y cumplimiento.</p>
                    </div>
                    <div class="w-full h-[400px] bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden shadow-inner">
                        <iframe src="/campaign_seminario.pdf" class="w-full h-full" title="Campaign Seminario"></iframe>
                    </div>
                    <div class="mt-4 text-center">
                        <a href="/campaign_seminario.pdf" target="_blank" class="inline-block text-xs font-semibold text-emerald-400 hover:text-emerald-300 underline">Abrir campaign_seminario.pdf en pantalla completa</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: ¿QUIÉN SOY? (con meme spoiler interactivo) -->
        <section id="quien-soy" class="py-24 max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center border-t border-slate-900">
            <div class="space-y-6">
                <span class="text-xs font-semibold tracking-wider uppercase text-emerald-400 bg-emerald-950/50 border border-emerald-800/50 px-3 py-1 rounded-full">¿Quién Soy?</span>
                <h2 class="text-3xl sm:text-4xl font-bold text-white">Periodista, comunicador y apasionado por el mundo digital</h2>
                <div class="space-y-4 text-slate-400 text-base leading-relaxed">
                    <p>Hola, soy Hector San Martín, tengo 32 años y soy oriundo de Coquimbo. Soy Periodista titulado de la Universidad Central de la generación 2013.</p>
                    <p>Desde que hice la práctica en el 2017, no pude despegarme del mundo digital, especialmente del Social Media, que es el área donde generalmente me muevo.</p>
                    <p>Sin embargo, durante algunos años también he podido trabajar en el mundo de los Esports, área que me ha dado bastante conocimiento sobre nuevas tecnologías, email marketing y comunicación empresarial.</p>
                </div>
            </div>
            
            <!-- Spoiler Meme interactivo -->
            <div class="flex flex-col items-center">
                <div class="w-full max-w-md bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-2xl">
                    <div class="text-xs font-semibold text-emerald-400 uppercase tracking-widest mb-4 text-center">Toque de humor del internet</div>
                    
                    <!-- Elemento Spoiler con <details> -->
                    <details class="group bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden transition-all">
                        <summary class="flex items-center justify-between p-4 cursor-pointer select-none font-medium text-slate-200 hover:text-emerald-400 bg-slate-900/50">
                            <span class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                Mostrar meme spoiler (Click para desplegar)
                            </span>
                            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-1 rounded">Spoiler</span>
                        </summary>
                        <div class="p-4 flex flex-col items-center border-t border-slate-800">
                            <img src="/meme_spoiler.jpg" alt="Meme spoiler de Héctor" class="rounded-xl w-full max-h-[450px] object-contain shadow-lg border border-slate-800">
                            <p class="text-xs text-slate-500 mt-3 text-center">Clásico momento capturado en la cocina.</p>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- SECCIÓN: CV (con visor Fancypdf / embed PDF) -->
        <section id="cv" class="py-24 bg-slate-900/30 border-t border-slate-900 max-w-7xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                <h2 class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Trayectoria y Formación</h2>
                <h3 class="text-3xl font-bold text-white">Currículum Vítae (Fancypdf Viewer)</h3>
                <p class="text-slate-400">Revisa o descarga mi CV completo directamente en formato PDF interactivo.</p>
            </div>
            <div class="flex justify-center gap-4 mb-8">
                <a href="/cv.pdf" target="_blank" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-6 py-3 rounded-xl transition-all shadow-lg flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Descargar CV en PDF
                </a>
            </div>
            <div id="cv-visor" class="w-full max-w-5xl mx-auto h-[700px] bg-slate-900 rounded-3xl border border-slate-800 overflow-hidden shadow-2xl p-2">
                <iframe src="/cv.pdf" class="w-full h-full rounded-2xl" title="CV Héctor San Martín"></iframe>
            </div>
        </section>

        <!-- SECCIÓN: CONTACTO -->
        <section id="contacto" class="py-24 max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-white">Hablemos sobre tu próximo proyecto</h2>
            <p class="text-slate-400 mb-12">Estoy disponible para oportunidades de consultoría, gestión de contenidos, campañas de mailing o community management.</p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                <a href="https://wa.me/56949080786?text=%C2%A1Hola%20H%C3%A9ctor!%20Me%20interesa%20conversar%20contigo." target="_blank" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500/50 py-4 px-6 rounded-2xl flex items-center gap-4 shadow-xl group w-full sm:w-auto justify-center transition-all">
                    <span class="text-emerald-400 group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                    </span>
                    <span class="text-lg font-semibold text-white group-hover:text-emerald-400 transition-colors">+56 9 4908 0786</span>
                </a>

                <a href="mailto:hectorsminostrosa@gmail.com" class="bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500/50 py-4 px-6 rounded-2xl flex items-center gap-4 shadow-xl group w-full sm:w-auto justify-center transition-all">
                    <span class="text-emerald-400 group-hover:scale-110 transition-transform">
