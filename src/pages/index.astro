---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {
  contacto,
  marcas,
  servicios,
  herramientas,
  reelsMarcas,
  reelsClaude,
  campanas,
  experiencia,
} from '../data/site';

const embedStyle =
  'background:#fff; border:0; border-radius:12px; margin:0 auto; max-width:400px; min-width:280px; padding:0; width:100%;';
---

<Layout
  title="Héctor San Martín | Periodista y community manager"
  description="Periodista y community manager en Santiago. Más de 7 años creando contenido, gestionando comunidades y produciendo video para marcas."
>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#" class="brand" aria-label="Inicio">
        <span class="brand-mark">HS</span>
        <span class="brand-name">Héctor San Martín</span>
      </a>
      <nav class="nav" aria-label="Secciones">
        <a href="#trabajo">Trabajo</a>
        <a href="#mailing">Mailing</a>
        <a href="#trayectoria">Trayectoria</a>
        <a href="#sobre-mi">Sobre mí</a>
      </nav>
      <a class="btn btn-primary btn-sm" href="#contacto">Contacto</a>
    </div>
  </header>

  <main id="contenido">
    <!-- PORTADA -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="hero-role">Periodista y community manager</p>
          <h1>Héctor San Martín</h1>
          <p class="hero-lead">
            Creo contenido, gestiono comunidades y produzco video para marcas. Llevo más de 7 años haciéndolo para
            empresas de ingeniería, medioambiente, banca, automotriz y veterinaria.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={contacto.whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Escríbeme por WhatsApp
            </a>
            <a class="btn btn-ghost" href="/cv.pdf" download>
              <Icon name="download" /> Descargar CV
            </a>
          </div>
        </div>

        <figure class="hero-photo">
          <img src="/perfil.jpg" alt="Retrato de Héctor San Martín" width="640" height="640" />
          <figcaption>
            <span class="status-dot" aria-hidden="true"></span>
            {contacto.ciudad}, disponible para nuevos proyectos
          </figcaption>
        </figure>
      </div>

      <div class="wrap">
        <div class="brands">
          <p class="brands-title">Marcas y equipos con los que he trabajado</p>
          <ul class="brands-list">
            {marcas.map((m) => <li>{m}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- QUÉ HAGO -->
    <section class="section" id="servicios">
      <div class="wrap">
        <div class="section-head">
          <h2>Qué hago</h2>
          <p>Mi base es el periodismo: entender un tema, encontrar la historia y contarla bien en cada formato.</p>
        </div>
        <div class="services">
          {
            servicios.map((s) => (
              <div class="service">
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </div>
            ))
          }
        </div>
        <p class="tools">
          <span>Herramientas que uso a diario:</span>
          {herramientas.map((h) => <span class="tool">{h}</span>)}
        </p>
      </div>
    </section>

    <!-- TRABAJO: REELS -->
    <section class="section" id="trabajo">
      <div class="wrap">
        <div class="section-head">
          <h2>Reels y video</h2>
          <p>Piezas que grabé, edité o produje para las marcas que gestiono y para proyectos propios.</p>
        </div>

        <div class="tabs" role="tablist" aria-label="Tipo de video">
          <button class="tab" role="tab" id="tab-marcas" aria-controls="panel-marcas" aria-selected="true">
            Para marcas <span class="count">{reelsMarcas.length}</span>
          </button>
          <button class="tab" role="tab" id="tab-claude" aria-controls="panel-claude" aria-selected="false" tabindex="-1">
            Hechos con Claude <span class="count">{reelsClaude.length}</span>
          </button>
        </div>

        <div class="panel" role="tabpanel" id="panel-marcas" aria-labelledby="tab-marcas">
          <div class="reels">
            {
              reelsMarcas.map((url) => (
                <div class="reel">
                  <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14" style={embedStyle}>
                    <a href={url} target="_blank" rel="noopener">Ver este reel en Instagram</a>
                  </blockquote>
                </div>
              ))
            }
          </div>
        </div>

        <div class="panel" role="tabpanel" id="panel-claude" aria-labelledby="tab-claude" hidden>
          <p class="panel-note">
            Animaciones y explicadores para Cero Anestesia TV, producidos con apoyo de Claude, la inteligencia
            artificial de Anthropic.
          </p>
          <div class="reels" data-lazy></div>
          <template id="tpl-claude">
            {
              reelsClaude.map((url) => (
                <div class="reel">
                  <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14" style={embedStyle}>
                    <a href={url} target="_blank" rel="noopener">Ver este reel en Instagram</a>
                  </blockquote>
                </div>
              ))
            }
          </template>
        </div>
      </div>
    </section>

    <!-- MAILING -->
    <section class="section" id="mailing">
      <div class="wrap">
        <div class="section-head">
          <h2>Email marketing</h2>
          <p>
            Campañas para Orbe Ambiental &amp; Legal dirigidas a empresas de Tarapacá. Puedes recorrer cada correo tal como
            llegó a la bandeja de entrada.
          </p>
        </div>
        <div class="mails">
          {
            campanas.map((c) => (
              <article class="mail">
                <header class="mail-head">
                  <span class="mail-avatar" aria-hidden="true">O</span>
                  <div>
                    <p class="mail-from">{c.remitente}</p>
                    <h3 class="mail-subject">{c.titulo}</h3>
                    <p class="mail-context">{c.contexto}</p>
                  </div>
                </header>
                <div class="mail-body" tabindex="0" aria-label={`Vista previa del correo: ${c.titulo}`}>
                  <img src={c.imagen} alt={`Correo de la campaña "${c.titulo}"`} loading="lazy" width="736" height="1916" />
                </div>
                <a class="mail-link" href={c.pdf} target="_blank" rel="noopener">
                  Abrir en PDF <Icon name="external" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TRAYECTORIA -->
    <section class="section" id="trayectoria">
      <div class="wrap">
        <div class="section-head">
          <h2>Trayectoria</h2>
          <p>Periodista y Licenciado en Comunicación Social de la Universidad Central (2013–2017).</p>
        </div>
        <ol class="timeline">
          {
            experiencia.map((e, i) => (
              <li class:list={['job', { 'job-current': i === 0 }]}>
                <p class="job-period">{e.periodo}</p>
                <div class="job-body">
                  <h3>
                    {e.cargo} <span class="job-company">en {e.empresa}</span>
                  </h3>
                  <p>{e.texto}</p>
                  {e.logros && (
                    <ul class="job-wins">
                      {e.logros.map((l) => (
                        <li>{l}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
        <a class="btn btn-ghost" href="/cv.pdf" download><Icon name="download" /> Descargar CV completo</a>
      </div>
    </section>

    <!-- SOBRE MÍ -->
    <section class="section" id="sobre-mi">
      <div class="wrap about">
        <div class="about-text">
          <h2>Sobre mí</h2>
          <p>
            Soy de Coquimbo y vivo en Santiago. Desde la práctica profesional en 2017 no me he despegado del mundo
            digital, especialmente de las redes sociales.
          </p>
          <p>
            También pasé varios años en los esports, donde aprendí sobre nuevas tecnologías, transmisiones en vivo,
            email marketing y comunicación con empresas. Hoy junto todo eso para que marcas técnicas se entiendan y se
            vean bien en redes.
          </p>
        </div>

        <details class="spoiler">
          <summary>
            <span>Una foto de archivo</span>
            <span class="spoiler-hint">Spoiler: tócala para verla</span>
          </summary>
          <div class="spoiler-body">
            <img src="/meme_spoiler.jpg" alt="Meme de Héctor en la cocina: alfajor primero, completos después" width="287" height="750" loading="lazy" />
            <p>Clásico momento capturado en la cocina.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="section contact" id="contacto">
      <div class="wrap">
        <h2>¿Conversamos?</h2>
        <p class="contact-lead">
          Estoy disponible para community management, contenido, producción audiovisual y campañas de mailing.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={contacto.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> {contacto.telefono}
          </a>
          <a class="btn btn-ghost" href={`mailto:${contacto.email}`}>
            <Icon name="mail" /> {contacto.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">© {new Date().getFullYear()} Héctor San Martín</div>
  </footer>

  <a class="wa-float" href={contacto.whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
    <Icon name="whatsapp" />
  </a>

  <script is:inline async src="https://www.instagram.com/embed.js"></script>
  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));

    function activate(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !selected;
      });

      // Los reels de la pestaña se cargan recién al abrirla, para que Instagram calcule bien su tamaño
      const panel = document.getElementById(tab.getAttribute('aria-controls')!);
      const lazy = panel?.querySelector<HTMLElement>('[data-lazy]');
      const tpl = panel?.querySelector<HTMLTemplateElement>('template');
      if (lazy && tpl && !lazy.dataset.loaded) {
        lazy.appendChild(tpl.content.cloneNode(true));
        lazy.dataset.loaded = 'true';
        (window as any).instgrm?.Embeds.process();
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        activate(next);
      });
    });
  </script>
</Layout>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    background: var(--green);
    color: var(--green-ink);
    padding: 8px 14px;
    border-radius: 8px;
  }

  /* Barra superior */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(10, 18, 34, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-weight: 700;
  }
  .brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--green);
    color: var(--green-ink);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .nav {
    display: flex;
    gap: 32px;
    font-size: 0.95rem;
  }
  .nav a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }
  .nav a:hover {
    color: var(--text);
  }
  .btn-sm {
    padding: 9px 16px;
    font-size: 0.92rem;
  }

  /* Portada */
  .hero {
    padding: clamp(56px, 9vw, 112px) 0 clamp(56px, 7vw, 88px);
    background: radial-gradient(ellipse 70% 60% at 85% 0%, rgba(47, 208, 140, 0.09), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .hero-role {
    color: var(--green);
    font-weight: 600;
    font-size: 1.05rem;
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(3rem, 7.4vw, 5.6rem);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .hero-lead {
    margin-top: 28px;
    max-width: 50ch;
    font-size: 1.2rem;
    color: #c4cedd;
  }
  .hero-actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-photo {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 400px;
  }
  .hero-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 20px;
    border: 1px solid var(--line);
  }
  .hero-photo figcaption {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px rgba(47, 208, 140, 0.18);
  }

  .brands {
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
  }
  .brands-title {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .brands-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    font-size: 1.12rem;
    font-weight: 600;
    color: #c4cedd;
  }

  /* Qué hago */
  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .service {
    padding-top: 20px;
    border-top: 2px solid var(--green);
  }
  .service p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .tools {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .tools > span:first-child {
    margin-right: 6px;
  }
  .tool {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.9rem;
  }

  /* Reels */
  .tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-bottom: 32px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .tab {
    font: inherit;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 10px 18px;
    border-radius: 9px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background-color 0.15s, color 0.15s;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    background: var(--surface-2);
    color: var(--text);
  }
  .count {
    font-size: 0.8rem;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--line);
  }
  .tab[aria-selected='true'] .count {
    background: var(--green);
    color: var(--green-ink);
  }
  .panel-note {
    max-width: 62ch;
    margin-bottom: 28px;
    color: var(--muted);
  }
  .reels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }
  .reel {
    min-width: 0;
  }

  /* Mailing */
  .mails {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .mail {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .mail-head {
    display: flex;
    gap: 14px;
    padding: 20px 22px;
    border-bottom: 1px solid var(--line);
  }
  .mail-avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #e6f5ee;
    color: #0d7a52;
    font-weight: 800;
  }
  .mail-from {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .mail-subject {
    margin-top: 2px;
  }
  .mail-context {
    margin-top: 4px;
    font-size: 0.88rem;
    color: var(--sky);
  }
  .mail-body {
    height: 560px;
    overflow-y: auto;
    background: #fff;
    overscroll-behavior: contain;
  }
  .mail-body img {
    width: 100%;
    height: auto;
  }
  .mail-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 16px 22px;
    border-top: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--green);
  }
  .mail-link :global(svg) {
    width: 16px;
    height: 16px;
  }
  .mail-link:hover {
    text-decoration: underline;
  }

  /* Trayectoria */
  .timeline {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
  }
  .job {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .job:last-child {
    border-bottom: 1px solid var(--line);
  }
  .job-period {
    color: var(--muted);
    font-size: 0.95rem;
    padding-top: 2px;
  }
  .job-current .job-period {
    color: var(--green);
    font-weight: 600;
  }
  .job-company {
    color: var(--muted);
    font-weight: 500;
  }
  .job-body {
    max-width: 68ch;
  }
  .job-body > p {
    margin-top: 8px;
    color: #c4cedd;
  }
  .job-wins {
    margin: 18px 0 0;
    padding: 18px 20px 18px 40px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: grid;
    gap: 8px;
  }
  .job-wins li::marker {
    color: var(--green);
  }

  /* Sobre mí */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .about-text p {
    margin-top: 18px;
    max-width: 60ch;
    color: #c4cedd;
    font-size: 1.08rem;
  }
  .spoiler {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .spoiler summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 650;
  }
  .spoiler summary::-webkit-details-marker {
    display: none;
  }
  .spoiler-hint {
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--green);
  }
  .spoiler[open] .spoiler-hint {
    color: var(--muted);
  }
  .spoiler-body {
    padding: 0 22px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .spoiler-body img {
    width: auto;
    max-height: 520px;
    border-radius: 10px;
  }
  .spoiler-body p {
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  /* Contacto */
  .contact h2 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
  }
  .contact-lead {
    margin-top: 16px;
    max-width: 52ch;
    color: #c4cedd;
    font-size: 1.15rem;
  }
  .contact-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer {
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Botón flotante de WhatsApp */
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 50;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
    transition: transform 0.15s;
  }
  .wa-float:hover {
    transform: scale(1.06);
  }
  .wa-float :global(svg) {
    width: 30px;
    height: 30px;
  }

  /* Responsive */
  @media (max-width: 980px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
    .reels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .nav {
      display: none;
